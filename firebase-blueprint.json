  "ai_whitelist": {
    "description": "Developer AI API Key shared quota whitelist and daily usage tracking",
    "documents": {
      "{whitelistId}": {
        "fields": {
          "email": { "type": "string" },
          "uid": { "type": "string" },
          "displayName": { "type": "string" },
          "photoURL": { "type": "string" },
          "status": { "type": "string" },
          "dailyLimit": { "type": "number" },
          "todayUsage": { "type": "number" },
          "todayTokens": { "type": "number" },
          "totalUsage": { "type": "number" },
          "totalTokensUsed": { "type": "number" },
          "quotaCycleDate": { "type": "string" },
          "requestedAt": { "type": "number" },
          "approvedAt": { "type": "number" },
          "lastUsedAt": { "type": "number" },
          "notes": { "type": "string" }
        }
      }
    }
  },
  "ai_daily_usage_history": {
    "description": "Historical log of daily AI calls and token usage aggregated by date and user",
    "documents": {
