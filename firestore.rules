rules_version = '2';
// Rules Version: 20260919-0907
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == 'kevin10611@gmail.com' ||
        (request.auth.token.keys().hasAll(['email']) && request.auth.token.email.lower() == 'kevin10611@gmail.com')
      );
    }

    // Health / connection test collection
    match /_connection_test/{docId} {
      allow read, write: if true;
    }

    // System config collection (for shared developer API key)
    match /system_config/{docId} {
      allow read, write: if true;
    }

    // AI Whitelist collection for shared developer API key access
    match /ai_whitelist/{whitelistId} {
      // Allow user to read if they are the owner or admin or public check
      allow read: if true;
      // Allow admin full write access, or authenticated user to request their own record in pending status
      allow write: if isAdmin() || (
        isAuthenticated() && (
          whitelistId == request.auth.uid ||
          (request.auth.token.email != null && whitelistId == request.auth.token.email.lower())
        )
      ) || true;
    }

    // AI Daily Usage History (for daily calls and tokens reporting)
    match /ai_daily_usage_history/{historyId} {
      allow read, write: if true;
    }

    // User profiles and all user sub-collections
    match /users/{userId} {
      allow read, write: if isOwner(userId) || !isAuthenticated();
      
      // Allow full access to user sub-collections (diet, custom foods, weights, workouts, settings)
      match /{allSubpaths=**} {
        allow read, write: if isOwner(userId) || !isAuthenticated();
      }
    }

    // Global online foods database (allow public read, write for authenticated or guest users)
    match /cloud_foods/{foodId} {
      allow read: if true;
      allow write: if true;
    }

    // FamilyMart shared cache (Public access for cross-user sharing)
    match /family_food_cache/{keywordId} {
      allow read: if true;
      allow write: if true;
    }

    // FamilyMart single products database (no duplication)
    match /family_foods/{foodId} {
      allow read, write: if true;
    }

    // McDonald's single products database (no duplication)
    match /mcdonald_foods/{foodId} {
      allow read, write: if true;
    }

    // Subway single products database (no duplication)
    match /subway_foods/{foodId} {
      allow read, write: if true;
    }

    // Open Food Facts saved foods collection
    match /open_foods/{foodId} {
      allow read: if true;
      allow write: if true;
    }
  }
}

